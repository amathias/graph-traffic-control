# Graph Traffic Control - example environment.
# Copy to .env and fill in. Never commit .env. Never put real tokens in this file.
#
# Variable names follow the portfolio shared contract in ../COORDINATOR_PLAN.md.
# Do not rename these without a coordinator proposal.

# --- Shared application contract ---
PROJECT_SLUG=graph-traffic-control
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8105
APP_PUBLIC_URL=http://127.0.0.1:8105
APP_STATE_DIR=demo/state

# --- DataHub connection ---
# Left blank locally. Phases 0-4 and 6 run fixture-backed with no DataHub.
# The coordinator supplies these for the live integration in Phase 5.
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_MCP_URL=http://localhost:8000/mcp
DATAHUB_TOKEN=

# --- DataHub namespace allocation (fixed by COORDINATOR_HANDOFF.md) ---
# Changing any of these requires a coordinator proposal. The namespace guard
# fails closed on any entity outside DATAHUB_URN_PREFIX.
DATAHUB_DOMAIN=Demo / Graph Traffic Control
DATAHUB_DOMAIN_URN=urn:li:domain:graph-traffic-control
DATAHUB_PROJECT_TAG=project-graph-traffic-control
DATAHUB_URN_PREFIX=traffic.

# `operation` argument for the MCP `update_description` tool. Must have replace-in-place
# semantics: the reversible writeback restores the captured original exactly, which an
# append-style operation could not do.
# LIVE-CONFIRMED against DataHub 1.6.0, which rejected the earlier `SET` guess and accepted
# `replace`. Kept configurable for a different server. See docs/LIMITATIONS.md.
DATAHUB_DESCRIPTION_OPERATION=replace

# --- Demo fixtures ---
DEMO_FIXTURE_ROOT=demo/fixtures/graph-traffic-control

